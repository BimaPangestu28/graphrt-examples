# Copy to .env.local and fill in. Only public values: never an LLM key, the
# Supabase service role key or the graphrt serve API key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The anon / publishable key (sb_publishable_... or the legacy anon JWT).
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# graphrt serve base URL. From an Android emulator use http://10.0.2.2:8080.
EXPO_PUBLIC_SERVE_URL=http://127.0.0.1:8080
# Optional: workflow name (file stem of the served yaml) and turns of history.
EXPO_PUBLIC_WORKFLOW=agent
EXPO_PUBLIC_HISTORY_TURNS=8
